  "inputs": {
    "title": {
      "type": "string",
      "maxLength": 48,
      "default": "",
      "description": "tiêu đề góc trên (để trống nếu video đã có)"
    },
    "body": {
      "type": "string",
      "enum": [
        "earth",
        "moon",
        "mercury",
        "venus",
        "mars",
        "jupiter",
        "saturn",
        "uranus",
        "neptune",
        "pluto",
        "charon",
        "io",
        "europa",
        "ganymede",
        "callisto",
        "titan",
        "enceladus"
      ],
      "default": "earth",
      "description": "thiên thể"
    },
    "view": {
      "type": "string",
      "enum": [
        "globe",
        "cross_section"
      ],
      "default": "globe",
      "description": "globe = quả cầu và nhãn địa danh; cross_section = cắt một phần tư, hiện từng lớp bên trong"
    },
    "clouds": {
      "type": "boolean",
      "default": true,
      "description": "lớp mây/sương (Sao Kim, Titan: tắt để thấy bề mặt bên dưới)"
    },
    "atmosphere": {
      "type": "boolean",
      "default": true,
      "description": "quầng khí quyển ở rìa"
    },
    "nightLights": {
      "type": "boolean",
      "default": true,
      "description": "đèn thành phố (Trái Đất) / dung nham (Io) bên đêm"
    },
    "rings": {
      "type": "boolean",
      "default": true,
      "description": "vành đai (Sao Thổ, Sao Thiên Vương, Sao Hải Vương, Sao Mộc)"
    },
    "moons": {
      "type": "boolean",
      "default": false,
      "description": "các vệ tinh lớn chạy trên quỹ đạo quanh hành tinh"
    },
    "dustStorm": {
      "type": "boolean",
      "default": false,
      "description": "Sao Hỏa: bão bụi lan dần phủ hành tinh"
    },
    "plumes": {
      "type": "boolean",
      "default": true,
      "description": "Enceladus: mạch phun hơi nước ở cực Nam"
    },
    "labels": {
      "type": "boolean",
      "default": true,
      "description": "nhãn địa danh bám theo bề mặt (hiện lần lượt theo mốc lời thoại)"
    },
    "facts": {
      "type": "boolean",
      "default": false,
      "description": "bảng số liệu (bán kính, ngày, năm, trọng lực, nhiệt độ, vệ tinh)"
    },
    "markers": {
      "type": "array",
      "maxItems": 4,
      "default": [],
      "description": "điểm tự đặt thay cho địa danh mặc định (vd. Hà Nội 21, 105.8)",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "min": -90,
            "max": 90,
            "required": true,
            "description": "vĩ độ"
          },
          "lon": {
            "type": "number",
            "min": -180,
            "max": 180,
            "required": true,
            "description": "kinh độ (Đông dương)"
          },
          "label": {
            "type": "string",
            "maxLength": 32,
            "required": true,
            "description": "tên"
          }
        }
      }
    },
    "sunAngle": {
      "type": "number",
      "min": -160,
      "max": 160,
      "default": 55,
      "description": "góc Mặt Trời so với người xem, độ: 0 = chiếu thẳng (tròn sáng), 90 = từ bên trái (nửa sáng), 150 = lưỡi liềm; âm = từ bên phải"
    },
    "spin": {
      "type": "number",
      "min": 0,
      "max": 4,
      "default": 1,
      "description": "tốc độ tự quay (0 = đứng yên); chiều quay theo thực tế"
    },
    "viewLat": {
      "type": "number",
      "min": -60,
      "max": 60,
      "default": 12,
      "description": "nhìn từ vĩ độ bao nhiêu (dương = từ phía Bắc, thấy vành đai mở rộng hơn)"
    },
    "realTilt": {
      "type": "boolean",
      "default": true,
      "description": "nghiêng trục theo số liệu thật (Sao Thiên Vương gần nằm ngang)"
    },
    "stars": {
      "type": "boolean",
      "default": false,
      "description": "nền sao (luôn có khi backdrop khác none)"
    }
  },
