  "cues": "mỗi nhãn địa danh (hoặc: mở mặt cắt, rồi từng lớp) hiện ở một mốc; bảng số liệu ở mốc cuối; địa danh đầu tiên quay ra trước mặt đúng lúc nó hiện",
  "accuracy": "Số liệu NASA (bán kính, chu kỳ tự quay và chiều quay, độ nghiêng trục); cấu trúc bên trong theo các mô hình đã công bố (tỉ lệ bán kính lõi/manti); lục địa Trái Đất từ Natural Earth 1:50m; vị trí địa danh, núi lửa, vết bão gần đúng; vành đai Sao Thổ theo bán kính thật các vành D, C, B, khe Cassini, A, F; bóng đổ vành ↔ hành tinh tính bằng hình học tia. Chu kỳ quỹ đạo vệ tinh giữ đúng tỉ lệ với nhau.",
  "limitations": "Bề mặt là texture thủ tục (không phải ảnh chụp) dựng quanh các đặc điểm thật; tốc độ quay được chiếu nhanh, khoảng cách và kích thước vệ tinh không theo tỉ lệ; mặt cắt là hình quạt 2D; đèn thành phố mang tính minh hoạ; lớp vỏ mỏng được phóng to.",
  "example_usage": "{\"component\":\"planet\",\"props\":{\"body\":\"mars\",\"dustStorm\":true,\"camera\":\"push_in\"}}",
  "combines_with": [
    "solar_orbit",
    "planet_rotation",
    "moon_phases",
    "space_mission",
    "sun_activity"
  ],
