{
  "name": "mmo-video-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js",
    "setup:tts": "python -m venv .venv && .venv\\Scripts\\python -m pip install edge-tts",
    "assets:cutouts": "node scripts/download-assets.js --only cutouts",
    "test:ai": "node scripts/test-ai.js",
    "make:video": "node scripts/make-video.js",
    "news": "node scripts/fetch-news.js",
    "preview:frames": "node scripts/preview-frames.js",
    "anim:build": "vite build -c motion/vite.config.mjs",
    "anim:render": "node motion/renderer/render.mjs",
    "anim:test": "node motion/tests/run.mjs",
    "anim:registry": "node motion/registry/build.mjs",
    "anim:search": "node motion/registry/search.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@motion-canvas/2d": "^3.17.2",
    "@motion-canvas/core": "^3.17.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
