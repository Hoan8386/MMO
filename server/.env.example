PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=mmo_video

# Claude API key (console.anthropic.com). Không có key thì tự chạy chế độ mock
ANTHROPIC_API_KEY=
# Dùng cổng trung gian (vd. Caheo AI): điền 2 dòng dưới, để trống ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# on/off — tắt nếu cổng trung gian báo lỗi tham số "fallbacks"
AI_FALLBACKS=on
# on/off — ép kết quả AI theo JSON schema (structured outputs). Để trống: bật khi gọi thẳng Anthropic, tắt khi dùng
# cổng trung gian (cổng giữ câu trả lời có schema đến khi xong và cắt kết nối im lặng ~90s); khi tắt, schema nằm trong prompt
AI_STRUCTURED=
# claude = gọi Claude API, mock = kế hoạch mẫu để chạy thử. Để trống: tự chọn theo API key
AI_MODE=
# Bước lập kế hoạch video: model và effort. effort low tiết kiệm token suy nghĩ
PLAN_MODEL=
PLAN_EFFORT=low

# Python that has edge-tts installed (npm run setup:tts creates .venv)
PYTHON_BIN=.venv\Scripts\python.exe

# HyperFrames CLI version used to render
HYPERFRAMES_VERSION=0.8.181
# Render MP4: số Chrome chụp khung hình song song (mỗi cái ~256 MB RAM; "auto" = HyperFrames tự chọn;
# mặc định = nửa số luồng CPU, tối đa 8), chất lượng (draft | looks | delivery) và GPU cho Chrome
# (auto | on | off — on ép dùng card đồ hoạ, off ép render phần mềm SwiftShader).
HF_WORKERS=
HF_QUALITY=looks
HF_BROWSER_GPU=auto

# Lồng tiếng bằng ElevenLabs (elevenlabs.io → API keys). Để trống thì dùng edge-tts
ELEVENLABS_API_KEY=
# elevenlabs | edge. Để trống: elevenlabs khi có ELEVENLABS_API_KEY
TTS_ENGINE=
# eleven_v4 (mặc định — đọc tiếng Việt chuẩn nhất), eleven_v3, hoặc eleven_flash_v2_5 (rẻ bằng nửa
# nhưng hay đọc sai chữ). Đổi model thì mọi câu được đọc lại ở lần dựng sau.
ELEVENLABS_MODEL=eleven_v4
# Số cảnh lồng tiếng cùng lúc (theo gói ElevenLabs: Free 2, Starter 3, Creator 5, Pro 10…)
ELEVENLABS_CONCURRENCY=5
