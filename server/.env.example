PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=mmo_video

# Claude API key (console.anthropic.com). Không có key thì tự chạy chế độ mock
ANTHROPIC_API_KEY=
# Dùng cổng trung gian (vd. Caheo AI): điền 2 dòng dưới, để trống ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# on/off — tắt nếu cổng trung gian báo lỗi tham số "fallbacks"
AI_FALLBACKS=on
# claude = gọi Claude API, mock = kế hoạch mẫu để chạy thử. Để trống: tự chọn theo API key
AI_MODE=
# Bước lập kế hoạch video: model và effort. effort low tiết kiệm token suy nghĩ
PLAN_MODEL=
PLAN_EFFORT=low

# Python that has edge-tts installed (npm run setup:tts creates .venv)
PYTHON_BIN=.venv\Scripts\python.exe

# HyperFrames CLI version used to render
HYPERFRAMES_VERSION=0.8.181
