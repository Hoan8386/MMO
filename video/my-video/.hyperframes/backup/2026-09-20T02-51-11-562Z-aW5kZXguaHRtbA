<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tin tức hôm nay</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      :root {
        --ink: #07121f;
        --ink-soft: #0d2032;
        --paper: #f4f7f8;
        --cyan: #70e1e8;
        --muted: #9bb1bd;
        --line: rgba(112, 225, 232, 0.28);
      }

      html,
      body {
        width: 1080px;
        height: 1920px;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: var(--ink);
        font-family: sans-serif;
      }

      #main-composition {
        position: relative;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        color: var(--paper);
        background: var(--ink);
      }

      .full-bleed {
        position: absolute;
        inset: 0;
      }

      .background {
        background: radial-gradient(circle at 78% 19%, #173b4a 0, #0d2231 20%, var(--ink) 58%);
      }

      .grid {
        background-image: linear-gradient(rgba(112, 225, 232, 0.08) 2px, transparent 2px),
          linear-gradient(90deg, rgba(112, 225, 232, 0.08) 2px, transparent 2px);
        background-size: 108px 108px;
        mask-image: linear-gradient(to bottom, transparent 0%, black 24%, black 72%, transparent 100%);
        opacity: 0.42;
      }

      .glow {
        width: 720px;
        height: 720px;
        top: 80px;
        right: -260px;
        border: 2px solid rgba(112, 225, 232, 0.2);
        border-radius: 50%;
        box-shadow: 0 0 120px rgba(112, 225, 232, 0.1), inset 0 0 80px rgba(112, 225, 232, 0.06);
      }

      .ring {
        width: 420px;
        height: 420px;
        top: 230px;
        left: -210px;
        border: 2px solid rgba(244, 247, 248, 0.14);
        border-radius: 50%;
      }

      .corner-mark {
        top: 122px;
        right: 82px;
        width: 86px;
        height: 86px;
        border-top: 4px solid var(--cyan);
        border-right: 4px solid var(--cyan);
      }

      .topline,
      .bottomline {
        position: absolute;
        left: 80px;
        right: 80px;
        height: 2px;
        background: var(--line);
        transform-origin: left center;
      }

      .topline { top: 132px; }
      .bottomline { bottom: 156px; }

      .header,
      .headline-block,
      .footer,
      .ending {
        position: absolute;
        left: 80px;
        right: 80px;
      }

      .header { top: 180px; }

      .kicker,
      .footer-label,
      .ending-label {
        margin: 0;
        color: var(--cyan);
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 6px;
        line-height: 1.2;
        text-transform: uppercase;
      }

      .edition {
        margin: 18px 0 0;
        color: var(--muted);
        font-size: 20px;
        letter-spacing: 2px;
      }

      .headline-block {
        top: 580px;
      }

      .headline {
        max-width: 920px;
        margin: 0;
        color: var(--paper);
        font-size: 116px;
        font-weight: 800;
        letter-spacing: 1px;
        line-height: 0.98;
        text-transform: uppercase;
      }

      .headline-rule {
        width: 180px;
        height: 8px;
        margin: 54px 0 34px;
        background: var(--cyan);
      }

      .subtitle {
        max-width: 720px;
        margin: 0;
        color: var(--muted);
        font-size: 38px;
        font-weight: 400;
        line-height: 1.28;
      }

      .footer { bottom: 190px; }

      .footer-label { color: var(--paper); font-size: 18px; letter-spacing: 4px; }

      .footer-label span { color: var(--cyan); }

      .ending {
        top: 750px;
        opacity: 0;
      }

      .ending-title {
        max-width: 780px;
        margin: 28px 0 0;
        color: var(--paper);
        font-size: 72px;
        font-weight: 700;
        line-height: 1.05;
      }

      .ending-rule {
        width: 100%;
        height: 2px;
        margin-top: 54px;
        background: var(--line);
        transform-origin: left center;
      }

      .ending-meta {
        display: flex;
        justify-content: space-between;
        margin-top: 28px;
        color: var(--muted);
        font-size: 20px;
        letter-spacing: 3px;
        text-transform: uppercase;
      }

      .headline,
      .headline-rule,
      .subtitle,
      .header,
      .footer,
      .ending,
      .topline,
      .bottomline,
      .glow,
      .ring,
      .corner-mark,
      .grid {
        will-change: transform, opacity;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-n8uj" id="main-composition" data-composition-id="main-video" data-start="0" data-duration="37.87" data-width="1080" data-height="1920">
      <div data-hf-id="hf-pfcc" class="full-bleed background"></div>
      <div data-hf-id="hf-hwps" class="full-bleed grid" data-start="14.81" data-duration="23.06" data-media-start="0"></div>
      <div data-hf-id="hf-zr77" class="full-bleed glow"></div>
      <div data-hf-id="hf-pifi" class="full-bleed ring"></div>
      <div data-hf-id="hf-doeb" class="full-bleed corner-mark"></div>
      <div data-hf-id="hf-o5lv" class="topline"></div>
      <div data-hf-id="hf-gc0b" class="bottomline"></div>

      <header data-hf-id="hf-hr6f" class="header">
        <p data-hf-id="hf-m9ld" class="kicker">Bản tin đặc biệt</p>
        <p data-hf-id="hf-dpxe" class="edition">THỨ TƯ · 17.09.2026</p>
      </header>

      <main data-hf-id="hf-6t1k" class="headline-block">
        <h1 data-hf-id="hf-cgi0" class="headline">Tin tức<br data-hf-id="hf-x5px">hôm nay</h1>
        <div data-hf-id="hf-953f" class="headline-rule"></div>
        <p data-hf-id="hf-qg5u" class="subtitle">Cập nhật những thông tin mới nhất</p>
      </main>

      <footer data-hf-id="hf-vadb" class="footer">
        <p data-hf-id="hf-d7jr" class="footer-label"><span data-hf-id="hf-enve">NEWS</span> / 24 GIỜ CẬP NHẬT</p>
      </footer>

      <section data-hf-id="hf-z4b1" class="ending">
        <p data-hf-id="hf-e8s9" class="ending-label">Tin tức hôm nay</p>
        <h2 data-hf-id="hf-y89g" class="ending-title">Luôn cập nhật.<br data-hf-id="hf-rsrt">Luôn kết nối.</h2>
        <div data-hf-id="hf-qzz8" class="ending-rule"></div>
        <div data-hf-id="hf-y1ud" class="ending-meta"><span data-hf-id="hf-mrpj">NEWS DESK</span><span data-hf-id="hf-a61j">24 / 7</span></div>
      </section>

      <script>
        (function () {
          const tl = gsap.timeline({ paused: true });
          const headline = document.querySelector(".headline");
          const subtitle = document.querySelector(".subtitle");
          const headlineRule = document.querySelector(".headline-rule");
          const endingRule = document.querySelector(".ending-rule");

          tl.fromTo(".grid", { opacity: 0 }, { opacity: 0.42, duration: 0.8, ease: "power2.out" }, 0)
            .fromTo(".glow", { opacity: 0, scale: 0.86 }, { opacity: 1, scale: 1, duration: 1.4, ease: "power2.out" }, 0)
            .fromTo(".ring", { opacity: 0, x: -70, rotation: -18 }, { opacity: 1, x: 0, rotation: 0, duration: 1.2, ease: "power3.out" }, 0.15)
            .fromTo(".corner-mark", { opacity: 0, x: 28, y: -18 }, { opacity: 1, x: 0, y: 0, duration: 0.7, ease: "back.out(1.6)" }, 0.35)
            .fromTo(".topline", { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "power3.out" }, 0.3)
            .fromTo(".bottomline", { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "power3.out" }, 0.45)
            .fromTo(".header", { opacity: 0, y: -26 }, { opacity: 1, y: 0, duration: 0.7, ease: "power3.out" }, 0.65)
            .fromTo(headline, { opacity: 0, y: 90, x: -36, rotation: -2 }, { opacity: 1, y: 0, x: 0, rotation: 0, duration: 1.05, ease: "power4.out" }, 1.05)
            .fromTo(headlineRule, { opacity: 0, scaleX: 0 }, { opacity: 1, scaleX: 1, duration: 0.65, ease: "power3.out" }, 1.7)
            .fromTo(subtitle, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 1.95)
            .fromTo(".footer", { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.65, ease: "power2.out" }, 2.35)
            .to(".glow", { rotation: 18, scale: 1.06, duration: 2.2, ease: "sine.inOut", repeat: 1, yoyo: true }, 2.4)
            .to(".ring", { rotation: 12, x: 24, duration: 2.8, ease: "sine.inOut", repeat: 1, yoyo: true }, 2.2)
            .to(".headline-block, .header, .footer", { opacity: 0, y: -32, duration: 0.7, ease: "power3.in" }, 6.65)
            .fromTo(".ending", { opacity: 0, y: 42 }, { opacity: 1, y: 0, duration: 0.85, ease: "power3.out" }, 7.05)
            .fromTo(endingRule, { scaleX: 0 }, { scaleX: 1, duration: 0.8, ease: "power3.out" }, 7.7)
            .to(".ending", { y: -8, duration: 1.2, ease: "sine.inOut", repeat: 1, yoyo: true }, 8.1);

          window.__timelines = window.__timelines || {};
          window.__timelines["main-video"] = tl;
        })();
      </script>
    </div>
  </body>
</html>
